# Bursting Bubble Simulation - Default Parameters (Newtonian)
# Format: key=value (one per line, # for comments)
# This file provides a typical configuration for bursting bubble simulations

# ============================================================
# Case Identification
# ============================================================
# Case number for folder naming (4-digit: 1000-9999)
# Output will be created in simulationCases/<CaseNo>/
CaseNo=1000

# Solver source stem in simulationCases/ (no .c). Allowed:
#   burstingBubble                    Newtonian, fixed-ceiling wavelet AMR
#   burstingBubble-drillResolution    Newtonian, feature-tracking drill
#   burstingBubbleVE                  Oldroyd-B, fixed-ceiling wavelet AMR
#   burstingBubbleVE-drillResolution  Oldroyd-B + drill (singularity path)
Solver=burstingBubble

# ============================================================
# Physical Parameters (Dimensionless Numbers)
# ============================================================
# Ohnesorge number: Oh = mu/sqrt(rho*sigma*R) (viscous / inertial-capillary)
# Controls viscous vs surface tension effects
# Typical values: 1e-3 (water-like) to 1e-1 (viscous)
Oh=1e-2

# Bond number: Bo = rho*g*R^2/sigma (gravity / surface tension)
# Controls gravitational effects on bubble shape
# Note: Currently only Bo=0.0010 geometry available (Bo0.0010.dat)
Bond=1e-3

# Gas/liquid Ohnesorge ratio: the gas-phase Ohnesorge number is
# Oha = OhRatio*Oh, setting the viscosity contrast across the interface
OhRatio=2e-2

# Viscoelastic knobs (Oldroyd-B). Consumed by burstingBubbleVE*.c;
# Newtonian solvers parse and ignore them. De=0 or Ec=0 is the Newtonian
# limit of the VE solver (identity conformation, zero polymeric stress).
# Oh is the SOLVENT Ohnesorge; polymeric viscosity is the derived product
# Oh_p = Ec*De. Keep Oh, De, and Ec as independent controls.
De=0
Ec=0

# Smear density/viscosity jumps (compile-time). 1 = define FILTERED for
# two-phase.h; 0 = sharp VOF properties. #ifdef, so 0 must not define it.
FILTERED=1

# ============================================================
# Mesh Adaptation (space)
# ============================================================
# Maximum refinement level (2^MAXlevel cells at finest resolution)
# Level 10 -> 1024 cells, Level 11 -> 2048 cells, Level 12 -> 4096 cells
# Higher levels give better accuracy but slower computation
MAXlevel=12

# Far-field coarsening floor (the interface is always kept at MAXlevel;
# this only limits how coarse the quiescent bulk is allowed to become)
MINlevel=4

# Initial uniform grid level used before adaptation kicks in
init_grid_level=5

# Wavelet error tolerance on the VOF tracer f (interface location)
fErr=1e-3

# Wavelet error tolerance on the velocity field
VelErr=1e-3

# Wavelet error tolerance on interface curvature
KErr=1e-6

# Wavelet error tolerance on conformation-tensor components (VE solvers)
AErr=1e-3

# ============================================================
# Time Resolution (adaptive)
# ============================================================
# dtmax is a CEILING on the timestep, not a fixed step: surface tension
# (tension.h) reduces the real step to the capillary-wave limit each
# iteration, so the effective timestep is set adaptively at run time.

# Advective CFL number
CFL=0.1

# Timestep ceiling; the capillary-wave limit sets the real adaptive step
dtmax=1e-2

# Poisson/viscous solver convergence tolerance
TOLERANCE=1e-4

# Snapshot/restart dump interval (capillary time units)
tsnap=1e-2

# ============================================================
# Time Control
# ============================================================
# Maximum simulation time (dimensionless, based on capillary time scale)
# t_cap = sqrt(rho * R^3 / sigma)
# Typical jet formation occurs at t ~ 0.5-2.0
tmax=1.5

# ============================================================
# Domain Configuration
# ============================================================
# zWall: distance from bubble south pole to bottom wall
# Controls domain size: Ldomain = min(zWall + 6.0, 16.0)
# Typical values:
#   zWall=0.05: Bubble very close to wall (current default)
#   zWall=0.025: Bubble very close to wall
#   zWall=2.0: Domain x in [-4, 4] (matches original setup)
#   zWall=4.0: Domain x in [-6, 4], wall at x=-6
zWall=4.0

# ============================================================
# Drill Adaptive-Resolution Trigger
# ============================================================
# These keys are consumed by burstingBubble-drillResolution.c and
# burstingBubbleVE-drillResolution.c. The plain solvers parse and ignore
# them, so leaving them here is harmless.
#
# The drill promotes the jet-base probe from a passive diagnostic into the
# driver of the mesh ceiling: it "drills" resolution into the collapsing region
# as the singularity approaches and relaxes it elsewhere. Mechanism modelled on
# comphy-lab/ElasticPinchOff (LiquidOutThinning.c), generalised from a
# neck-radius scalar to the two-regime bursting-bubble probe. See the solver
# header and DRILL-RESOLUTION.md (repo root) for the full description.

# Master switch. 1 = feature-tracking ramp of the local ceiling maxlevelLocal;
# 0 = pin maxlevelLocal at MAXlevel, reproducing the fixed-level reference run
# bit-for-bit (use 0 for A/B validation against burstingBubble.c).
drillAMR=1

# Coarsest level the ramp is allowed to fall to (ramp floor). The far field
# still coarsens to MINlevel through the wavelet criterion; this only caps how
# coarse the tracked-feature band may become. For a from-scratch run this must
# resolve the initial film — prefer the two-stage workflow (fixed-level Stage 1
# to rupture the film, drill Stage 2 for collapse/jet/pinch).
drillMaxlevelStart=8

# Cells the tracked length must span before the current level is deemed enough.
# Two regimes because a curving front and a slender column resolve differently:
#   drillNcellsK   -> cavity-focus (curvature-radius 1/|kappa|_max), pre-inception
#   drillNcellsJet -> jet-base radius r_b, post-inception
# Calibration knob: nCells=5 tracked the fixed-level-12 reference kinetic energy
# to ~1% through the pre-focus phase while running two levels coarser. Raise for
# a tighter match, lower for more aggressive savings.
drillNcellsK=5
drillNcellsJet=5

# Level to relax the ceiling to after the FIRST tip droplet sheds
# (jetFormed && n_components>1). <=0 disables relaxation, holding resolution on
# the receding base — the safe default, because the target observable R_j x Q_L
# is measured at the base. Set >0 (e.g. 9-10) to run the long post-pinch tail
# cheaply once you have confirmed the base measurement is complete.
drillRelaxLevel=-1

# Adaptive time-resolution of OUTPUT: 1 = tighten tsnap as the mesh refines so
# the fast jet/pinch window is sampled densely (tsnap = base * 2^(start-level));
# 0 = uniform tsnap. (The solver timestep itself is always adaptive via the
# capillary-wave limit in tension.h and tightens automatically as the mesh
# refines — this knob only controls snapshot cadence.)
drillTsnapStages=1

# Floor on the staged snapshot interval as a fraction of tsnap, so a low
# drillMaxlevelStart cannot trigger a snapshot storm. tsnap never falls below
# drillTsnapMinFactor * tsnap.
drillTsnapMinFactor=0.1

# Pre-inception cap on the demanded level. The cavity-focus collapse is a
# genuine singularity: chasing it with the full MAXlevel stalls dt (CFL chases
# the diverging focusing velocity in ever-smaller cells) and blows up ke at the
# topology change — case 1005 (MAXlevel=14) died exactly this way at t=0.46887,
# while the level-12 case 1004 stepped straight over the same instant. Cap the
# focus regime at a level proven to cross (12), and the full MAXlevel is
# released once the inception latch fires (the slender jet is fast but smooth,
# so deep refinement is safe and useful there). <=0 disables the cap.
drillMaxlevelFocus=-1

# Kinetic-energy safety gates (checked every step after the first 10). The
# blow-up gate keStopMax is historical and AD HOC (1e2): a localised transient
# spike — e.g. at the refinement release near the singular instant — can exceed
# it and still self-recover, while a genuine divergence also stalls dt. Relax
# it deliberately (e.g. 1e4) together with an external dt/progress watchdog to
# force a run through the singularity; keStopMin stops a fully dissipated run.
keStopMax=1e2
keStopMin=1e-6

# Remove gas fragments smaller than this side length in cells (components below
# drillRemoveGasSize^2 cells in 2D axi are absorbed into the liquid), every
# step, via tag.h's remove_droplets(bubbles=true). Kills the sub-grid gas wisps
# shed by the cavity reconnection that drive the CFL stall at high MAXlevel.
# Liquid droplets are never touched (shed tip droplets are physics). At
# MAXlevel=14, size 3 removes gas structures below ~2e-3 R0 — smaller than
# anything the validated level-12 run could even represent. 0 disables.
drillRemoveGasSize=0

# Force the inception latch (jetFormed=1) at init after a successful restore.
# For restarts from LEGACY post-inception dumps that predate the drillstate
# sidecar file: without it, such a restart can never re-latch (the arm/fire
# latch needs to see the final singular approach) and the focus cap silently
# re-binds the whole jet at drillMaxlevelFocus. Newer runs restore the latch
# state automatically from `drillstate`; this knob only ever SETS the latch,
# never clears it. Keep 0 unless restarting an old post-inception dump.
drillAssumeJet=0
